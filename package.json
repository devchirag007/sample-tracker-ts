{
  "name": "sample-tracker-ts",
  "version": "1.0.0",
  "description": "Lab sample tracking API (TypeScript practice repo, Node 16)",
  "private": true,
  "main": "dist/server.js",
  "engines": {
    "node": ">=16.20"
  },
  "scripts": {
    "dev": "nodemon --watch src --ext ts --exec ts-node --transpile-only src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write ."
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.3",
    "helmet": "^7.2.0",
    "pino": "^8.21.0",
    "pino-http": "^8.6.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/jest": "^29.5.14",
    "@types/node": "^16.18.126",
    "@types/supertest": "^2.0.16",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.57.1",
    "jest": "^29.7.0",
    "nodemon": "^3.1.14",
    "pino-pretty": "^10.3.1",
    "prettier": "^3.9.9",
    "supertest": "^6.3.4",
    "ts-jest": "^29.4.13",
    "ts-node": "^10.9.2",
    "typescript": "~5.4"
  }
}
